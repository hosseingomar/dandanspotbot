# ============================================================
# Telegram Bot Configuration (REQUIRED)
# ============================================================
# 1. Open Telegram and search for @BotFather (https://t.me/BotFather)
# 2. Send /newbot and choose a name and username.
# 3. Paste the bot token below:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Restrict bot usage to your own Telegram numeric user ID
# Get your ID by messaging @userinfobot on Telegram.
# Leave empty to allow anyone who accesses the bot to use it.
ALLOWED_TELEGRAM_USER_IDS=

# ============================================================
# Spotify Settings (100% Free - NO Spotify Premium Needed!)
# ============================================================
# You DO NOT need Spotify Developer credentials or Spotify Premium.
# You can monitor any Spotify playlist simply by sending:
# /setplaylist <your_playlist_url> to the bot!

# (Optional: Only if you have a Spotify Developer App with Web API enabled)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# How often to check your monitored playlist for new songs (in seconds)
CHECK_INTERVAL_SECONDS=60

# ============================================================
# Network & Audio Settings
# ============================================================
# Audio bitrate (192, 256, or 320 kbps). Default is 256.
# Lower bitrates (e.g. 192 or 256) upload significantly faster on slower connections.
AUDIO_BITRATE=256

# Maximum time in seconds to wait for file upload to Telegram (default: 300s = 5 minutes)
UPLOAD_TIMEOUT_SECONDS=300

# Optional: If you use a proxy/VPN to access Telegram, specify it here:
# Examples:
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# TELEGRAM_PROXY=http://127.0.0.1:10809
TELEGRAM_PROXY=

# ============================================================
# Cloud & Database Settings (Optional)
# ============================================================
# Cloud persistent database URL (e.g., free PostgreSQL from Neon.tech or Supabase).
# If left empty, the bot uses a local SQLite database (data.db).
DATABASE_URL=

# Port for cloud health check web server (Render, Hugging Face Spaces, Koyeb)
PORT=8080
